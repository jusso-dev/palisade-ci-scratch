# libFuzzer dictionary for the script_sig target: signature block markers,
# comment prefixes, line breaks and byte order marks.
# Use with: cargo +nightly fuzz run script_sig -- -dict=fuzz/script.dict
"# SIG # Begin signature block"
"# SIG # End signature block"
"<!-- SIG # Begin signature block -->"
"<!-- SIG # End signature block -->"
"/* SIG # Begin signature block */"
"/* SIG # End signature block */"
"'' SIG '' Begin signature block"
"'' SIG '' End signature block"
"// SIG // Begin signature block"
"// SIG // End signature block"
"<signature>"
"</signature>"
"** SIG ** "
"'' SIG '' "
"// SIG // "
"# "
"<!-- "
" -->"
"</job>"
"\x0d\x0a"
"\x0a"
"\xef\xbb\xbf"
"\xff\xfe"
"\xfe\xff"
"MII"
"=="
